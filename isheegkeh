<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Arda & Irmak Kalp Yağmuru</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: #030305;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            touch-action: none;
        }

        canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        .content-box {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            align-items: center;
            pointer-events: none;
        }

        .neon-heart-container {
            width: 220px;
            height: 220px;
            display: flex;
            justify-content: center;
            align-items: center;
            animation: pulseGlow 2s ease-in-out infinite alternate;
        }

        svg {
            width: 100%;
            height: 100%;
            filter: drop-shadow(0 0 12px #ffffff);
        }

        .heart-path {
            fill: rgba(255, 255, 255, 0.15);
            stroke: #ffffff;
            stroke-width: 3.5;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        @keyframes pulseGlow {
            0% { transform: scale(1); }
            100% { transform: scale(1.06); }
        }

        /* Site açılır açılmaz daktilo efektiyle yazılan isimler */
        .names {
            margin-top: 25px;
            color: #ffffff;
            font-family: monospace;
            font-size: 22px;
            letter-spacing: 3px;
            text-align: center;
            white-space: nowrap;
            overflow: hidden;
            border-right: 2px solid #ffffff;
            width: 0;
            text-shadow: 0 0 10px #ffffff, 0 0 20px #ffffff;
            animation: typing 3s steps(15, end) 0.5s forwards, blinkCursor 0.7s step-end infinite;
        }

        @keyframes typing {
            from { width: 0; }
            to { width: 15ch; }
        }

        @keyframes blinkCursor {
            from, to { border-color: transparent; }
            50% { border-color: #ffffff; }
        }
    </style>
</head>
<body>

    <canvas id="canvas"></canvas>

    <div class="content-box">
        <div class="neon-heart-container">
            <svg viewBox="0 0 24 24">
                <path class="heart-path"
                      d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
        </div>
        <div class="names">Arda 🤍 Irmak</div>
    </div>

    <script>
        const canvas = document.getElementById('canvas');
        const ctx = canvas.getContext('2d');

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        let particles = [];
        // Dokununca çıkacak renkli ve şık neon tonları
        const colors = ['#ffffff', '#ff2a75', '#ff416c', '#ff758c', '#ff7eb3'];

        class HeartParticle {
            constructor(x, y) {
                this.x = x;
                this.y = y;
                const angle = Math.random() * Math.PI * 2;
                const speed = Math.random() * 3 + 1;
                this.vx = Math.cos(angle) * speed;
                this.vy = Math.sin(angle) * speed;
                this.size = Math.random() * 8 + 8; // Kalp boyutu
                this.alpha = 1;
                this.decay = Math.random() * 0.02 + 0.012;
                this.color = colors[Math.floor(Math.random() * colors.length)];
                this.rotation = Math.random() * Math.PI * 2;
            }

            update() {
                this.x += this.vx;
                this.y += this.vy;
                this.alpha -= this.decay;
            }

            draw() {
                ctx.save();
                ctx.translate(this.x, this.y);
                ctx.rotate(this.rotation);
                ctx.globalAlpha = this.alpha;
                ctx.fillStyle = this.color;
                ctx.shadowBlur = 10;
                ctx.shadowColor = this.color;

                // Canvas üzerinde küçük bir kalp şekli çizen fonksiyon
                ctx.beginPath();
                let d = this.size;
                ctx.moveTo(0, d / 4);
                ctx.bezierCurveTo(0, 0, -d / 2, -d / 2, -d / 2, d / 4);
                ctx.bezierCurveTo(-d / 2, d / 2, 0, d * 0.75, 0, d);
                ctx.bezierCurveTo(0, d * 0.75, d / 2, d / 2, d / 2, d / 4);
                ctx.bezierCurveTo(d / 2, -d / 2, 0, 0, 0, d / 4);
                ctx.fill();

                ctx.restore();
            }
        }

        function addParticles(x, y) {
            for (let i = 0; i < 2; i++) {
                particles.push(new HeartParticle(x, y));
            }
        }

        window.addEventListener('mousemove', (e) => {
            addParticles(e.clientX, e.clientY);
        });

        window.addEventListener('touchmove', (e) => {
            for (let i = 0; i < e.touches.length; i++) {
                addParticles(e.touches[i].clientX, e.touches[i].clientY);
            }
        });

        window.addEventListener('touchstart', (e) => {
            for (let i = 0; i < e.touches.length; i++) {
                addParticles(e.touches[i].clientX, e.touches[i].clientY);
            }
        });

        function animate() {
            ctx.fillStyle = 'rgba(3, 3, 5, 0.2)';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            for (let i = particles.length - 1; i >= 0; i--) {
                particles[i].update();
                particles[i].draw();

                if (particles[i].alpha <= 0) {
                    particles.splice(i, 1);
                }
            }

            requestAnimationFrame(animate);
        }

        animate();
    </script>
</body>
</html>
